<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:background="?attr/colorOnPrimary"
        android:orientation="vertical"
        app:behavior_hideable="true"
        android:visibility="visible"
        app:behavior_peekHeight="240dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <TextView
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/setting_activity_button_height"
            android:gravity="center"
            android:textSize="19sp"
            android:text="@string/add_to_playlist"
            android:theme="@style/PlayerTextViewTheme" />

        <TextView
            android:id="@+id/addPlaylistButton"
            android:layout_width="@dimen/clear_history_button_width"
            android:layout_height="@dimen/clear_history_button_height"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/setting_activity_button_padding_end"
            android:fontFamily="@font/ys_display_medium"
            android:gravity="center"
            android:text="@string/new_playlist_button_name"
            android:textSize="@dimen/refresh_button_text_size"
            android:theme="@style/ButtonTheme" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewPlaylistPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/setting_activity_button_padding_end"
            android:visibility="visible"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>